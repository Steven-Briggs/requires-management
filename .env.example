# requires.management — environment configuration
# Copy to .env and fill in values. Never commit .env to git.

# Server
BIND_ADDR=127.0.0.1:8082

# Database
DATABASE_URL=postgres://username:password@localhost/requires_management

# Session
# Generate with: openssl rand -base64 64
SESSION_SECRET_KEY=replace_with_64_plus_char_random_string

# Discord OAuth
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://requires.management/auth/callback

# Clan settings
# The Discord server (guild) ID for your clan
DISCORD_CLAN_GUILD_ID=your_clan_server_id
# Optional: a specific role ID required for Clan tier. 
# If unset, any server member gets Clan tier.
DISCORD_CLAN_ROLE_ID=

# Logging
RUST_LOG=requires_management=info,actix_web=info
COOKIE_SECURE=false  # set to true in production

[Unit]
Description=requires.management platform server
After=network.target postgresql.service

[Service]
Type=simple
User=rocin
WorkingDirectory=/home/rocin/services/requires-management
EnvironmentFile=/home/rocin/services/requires-management/.env
ExecStart=/home/rocin/services/requires-management/target/release/requires-management
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=requires-management

[Install]
WantedBy=multi-user.target
